print("hello".upper())
print("HELLO".lower())
print("  x  ".trim())
print("a,b,c".split(","))
print("abc".chars())
print("hello".contains("ell"))
print("hello".startsWith("he"))
print("hello".endsWith("lo"))
print("a-b".replace("-", "+"))
print("abcdef".slice(1, 4))
print("hello".indexOf("l"))
print("ab".repeat(3))
print("7".padStart(3, "0"))
print("abc".reverse())
print("".isEmpty())
print("42".toNum())
print("no".toNum())

// Chaining reads left to right.
print("  Hello World  ".trim().lower().split(" ").join("_"))
