let xs = [3, 1, 2]

print(xs.len())
print(xs.sort())
print(xs.sorted())
print(xs.reverse())
print(xs.reversed())
print(xs.contains(2))
print(xs.indexOf(2))
print(xs.first())
print(xs.last())
print(xs.at(-1))
print(xs.sum())
print(xs.map(fn(n) { n * 2 }))
print(xs.filter(fn(n) { n > 1 }))
print(xs.reduce(fn(a, b) { a + b }, 0))
print(xs.find(fn(n) { n == 2 }))
print(xs.any(fn(n) { n > 2 }))
print(xs.all(fn(n) { n > 0 }))
print(xs.count(fn(n) { n > 1 }))
print([1, 1, 2].unique())
print([[1], [2]].flatten())
print(["a", "b"].join("-"))
print([1, 2, 3, 4].take(2))
print([1, 2, 3, 4].drop(2))
print([1, 2].zip(["a", "b"]))
print(["a", "b"].enumerate())
print([].isEmpty())

// push and pop still mutate in place, as their names say.
var m = [1]
m.push(2)
print(m)
print(m.pop())
print(m)
