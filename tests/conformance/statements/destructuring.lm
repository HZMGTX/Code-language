// A `let` may take a value apart, using the same patterns `match` and `for`
// use. This is how a function returns more than one thing.

fn minMax(xs) { [min(xs), max(xs)] }

let [lo, hi] = minMax([3, 1, 4, 1, 5])
print("${lo}..${hi}")

// A rest binding takes whatever is left.
let [head, ..tail] = [1, 2, 3, 4]
print(head)
print(tail)

// Patterns nest, and `_` throws a piece away.
let [[x, y], _, z] = [[1, 2], "ignored", 3]
print([x, y, z])

// `var` makes the bindings mutable; `let` does not.
var [a, b] = [1, 2]
a = 10
print([a, b])

// The whole point: two results, no wrapper struct, no out-parameter.
fn divide(n, d) { [floor(n / d), n % d] }
let [whole, remainder] = divide(17, 5)
print("17 = ${whole} * 5 + ${remainder}")

// The same shape on the left of an ordinary assignment, which is how a swap
// becomes one line. The right side is evaluated first, so no temporary is
// needed and no order of writes can spoil it.
var p = 1
var q = 2
[p, q] = [q, p]
print([p, q])

// Any place can be an element: a field, an index, a nested list.
struct Point { x: Num, y: Num }
var here = Point { x: 0, y: 0 }
var row = [0, 0]
[here.x, row[1]] = [7, 8]
print([here.x, row[1]])
