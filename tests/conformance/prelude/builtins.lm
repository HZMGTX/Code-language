// Not a single import in this file.
print(range(5))
print(range(2, 6))
print(range(10, 0, -2))
print(range(0, 0))

print(sum([1, 2, 3]))
print(min([5, 2, 9]))
print(max([5, 2, 9]))
print(min(3, 1, 2))
print(max(3, 1, 2))
print(abs(-4))
print(round(2.6))
print(floor(2.6))
print(ceil(2.1))

print(sorted([3, 1, 2]))
print(reversed([1, 2, 3]))
print(enumerate(["a", "b"]))
print(zip([1, 2], ["a", "b"]))
print(any([1, 2], fn(n) { n > 1 }))
print(all([1, 2], fn(n) { n > 0 }))
print(map([1, 2], fn(n) { n * 3 }))
print(filter([1, 2, 3], fn(n) { n % 2 == 1 }))
print(reduce([1, 2, 3], fn(a, b) { a + b }, 0))
print(split("a,b", ","))
print(join(["a", "b"], "+"))

print(sum(range(101)))
