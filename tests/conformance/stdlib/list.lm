import { map, filter, reduce, find, any, all, count, len as listLen, isEmpty,
         first, last, at, push, pop, slice, take, drop, reverse, contains,
         indexOf, unique, flatten, join, sort, sortBy, sum, zip, enumerate } from "std/list"

let xs = [3, 1, 2]
print(map(xs, fn(n) { n * 10 }))
print(filter(xs, fn(n) { n > 1 }))
print(reduce(xs, fn(acc, n) { acc + n }, 0))
print(find(xs, fn(n) { n == 2 }))
print(any(xs, fn(n) { n > 2 }))
print(all(xs, fn(n) { n > 0 }))
print(count(xs, fn(n) { n > 1 }))
print(listLen(xs))
print(isEmpty([]))
print(first(xs))
print(last(xs))
print(at(xs, -1))
print(slice([1,2,3,4], 1, 3))
print(take([1,2,3,4], 2))
print(drop([1,2,3,4], 2))
print(reverse(xs))
print(contains(xs, 2))
print(indexOf(xs, 2))
print(unique([1, 1, 2, 2, 3]))
print(flatten([[1, 2], [3]]))
print(join(["a", "b"], "-"))
print(sort(xs))
print(sort(["b", "a"]))
print(sortBy([[2, "two"], [1, "one"]], fn(pair) { pair[0] }))
print(sum(xs))
print(zip([1, 2], ["a", "b"]))
print(enumerate(["a", "b"]))

// push and pop mutate in place; everything else is pure.
var mutable = [1]
push(mutable, 2)
print(mutable)
print(pop(mutable))
print(mutable)
