// A date that does not exist is refused, not moved.
//
// The host validates a month and rejects `2024-13-01`, and then accepts
// `2024-02-30` and quietly answers March 1st — so a date read out of somebody's
// file moves by a day and nothing says so. That is not a policy, it is an
// inconsistency: if rolling over were the intent, month 13 would roll over into
// next January too.
import { parseIso, iso, date, time, format } from "std/time"

fn read(text) {
  match parseIso(text) {
    Ok(at)    => iso(at),
    Err(why)  => why,
  }
}

// February, which is the whole reason this matters.
print(read("2024-02-29"))
print(read("2024-02-30"))
print(read("2023-02-29"))
print(read("2000-02-29"))
print(read("1900-02-29"))

// The other short months.
print(read("2024-04-31"))
print(read("2024-06-31"))
print(read("2024-09-31"))
print(read("2024-11-31"))
print(read("2024-01-31"))

// With a time, and with an offset, because the day is checked either way.
print(read("2024-02-30T12:00:00Z"))
print(read("2024-02-30 12:00:00"))
print(read("2024-02-29T12:00:00+05:30"))

// What the host already rejects, unchanged.
print(read("2024-13-01"))
print(read("2024-00-01"))
print(read("2024-01-00"))

// And the defaults the signatures now state correctly. `time` shows seconds
// unless asked not to, and `format` has a template rather than an empty string.
let noon = 1709210415000
print(time(noon))
print(time(noon, seconds: false))
print(format(noon))
print(date(noon))
