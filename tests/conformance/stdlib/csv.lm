// `std/csv` — comma-separated values, as they actually arrive.
//
// CSV looks like `text.split("\n").map(fn(l) { l.split(",") })` and is not.
// That version is wrong for any file containing a comma, a quote or a newline
// inside a field — which is to say, for any file a spreadsheet has exported.
import { rows, records, write, writeRecords } from "std/csv"

// All three of the awkward cases at once.
let messy = "name,note,qty
\"Smith, Ada\",\"she said \"\"yes\"\"\",3
\"multi
line\",plain,1"

print(rows(messy))
print(records(messy))

// Reading and writing are inverses, byte for byte.
match rows(messy) {
  Ok(grid) => print(write(grid).unwrapOr("?") == "${messy}\n"),
  Err(w)   => print("ERR ${w}"),
}

// A ragged row is an error, not a guess: padding it makes every later column
// wrong by one, and dropping the extras throws data away. A duplicate column
// is an error for the same reason — one of the two would silently win, and
// which one is not something a reader could predict.
print(records("a,b\n1"))
print(records("a,b\n1,2,3"))
print(records("a,a\n1,2"))
print(rows("a,\"unterminated"))

// The shapes a real file comes in.
print(rows(""))
print(rows("a"))
print(rows("a\n"))
print(rows("x\r\ny\r\n"))
print(rows("a,b;c", delimiter: ";"))

// A `\r\n` inside a quoted field is data, not a line ending.
print(rows("\"a\r\nb\"").unwrapOr([]))

// A header with no rows under it is no records, not an error.
print(records("a,b\n"))

// Writing quotes only what has to be quoted.
print(write([["plain", "has,comma"], ["has\"quote", "has\nnewline"]]))

// Columns come from the first record, in the order it holds them — a Lumen Map
// keeps its insertion order, so the output is the shape the program built
// rather than an alphabetical surprise.
print(writeRecords([{ b: 2, a: 1 }, { a: 3, b: 4 }]))
print(writeRecords([{ a: 1, b: 2 }], columns: ["b"]))

// A record missing a column gets an empty field: an absent value and an empty
// one mean the same thing in a format with no nulls.
print(writeRecords([{ a: 1 }, { b: 2 }]))
print(writeRecords([]))
