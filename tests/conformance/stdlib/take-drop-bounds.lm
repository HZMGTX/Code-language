// `take` and `drop` count forwards, and refuse a count that does not.
//
// Both passed their number straight to `Array.prototype.slice`, which reads a
// negative one as an offset from the *end* — so `take(xs, -2)` answered "all
// but the last two" and `drop(xs, -2)` answered "only the last two", which is
// the opposite of what each one documents ("the first n elements", "everything
// after the first n"). `chunk` and `windows` in the same module already refuse
// a negative count, so it was a disagreement inside the module as well.
//
// A count computed as `len(xs) - wanted` going negative is the ordinary way to
// arrive here, and it silently returned the wrong end of the list.
import { take, drop } from "std/list"

let xs = [1, 2, 3, 4, 5]

// Forwards, including both edges and past the end.
print(take(xs, 0))
print(take(xs, 2))
print(take(xs, 5))
print(take(xs, 99))
print(drop(xs, 0))
print(drop(xs, 2))
print(drop(xs, 5))
print(drop(xs, 99))

// Together they partition the list, which is the property that made the old
// behaviour wrong rather than merely surprising.
for n in [0, 1, 3, 5] {
  print("${n}: ${take(xs, n)} + ${drop(xs, n)} == ${take(xs, n) + drop(xs, n) == xs}")
}

// And an empty list.
print(take([], 3))
print(drop([], 3))
