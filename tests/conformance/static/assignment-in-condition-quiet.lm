// Everything here is a condition that compares, and RS013 stays silent.
// An assignment inside a comparison is a comparison; an assignment on its own
// line is a statement; and `==` is what a condition looks like.
var x = 1
var last = 0
if x == 2 { print("no") } else { print("x is ${x}") }
while x < 3 { x += 1 }
print(x)
if (last = x) != 0 { print("assigned inside a comparison: ${last}") }
if x == 3 and last == 3 { print("both") }
if not (x == 4) { print("not four") }
let n = 5
print(match n {
  m if m == 5 => "five",
  _ => "other",
})
if true {
  x = 10
  print(x)
}
