// Counting words in a paragraph, and drawing the result.
//
//   lumen run examples/wordcount.lm
//
// The whole program is Str and Map methods doing the work: `chars` to throw the
// punctuation away, `split` to cut the words apart, a Map to tally them, and
// `sortBy` to bring the common ones to the top. Nothing below knows anything
// about this particular paragraph, so change it and run it again.

let passage = "The harbour wakes slowly. First the gulls, then the engines, then
the men who mend the nets the sea has spent all winter tearing. Nobody here
hurries, and the tide will not be hurried either: the boats go out when the tide
says they may go out. A boy counts the boats as they leave, and counts them
again as they come back, and on a good morning the two counts agree."

// What a word is allowed to be made of. Everything else - full stops, colons,
// the line breaks above - is a gap between words. The apostrophe is in the list
// so that "don't" stays one word rather than becoming two.
let wordChars = "abcdefghijklmnopqrstuvwxyz'"

// Lowercase first, so "The" and "the" land on the same key. Blanking the
// punctuation out rather than deleting it matters: "slowly. First" would come
// back as one word otherwise. That leaves runs of spaces, and split turns those
// into empty strings, which the last step drops.
fn wordsOf(text) {
  text
    .lower()
    .chars()
    .map(fn(ch) { if wordChars.contains(ch) { ch } else { " " } })
    .join("")
    .split(" ")
    .filter(fn(word) { !word.isEmpty() })
}

// A Map is the natural tally. A key that has never been set reads as nil, so
// the first sighting of a word starts it at one.
fn tallyOf(words) {
  var counts = {}
  for word in words { counts[word] = if counts[word] == nil { 1 } else { counts[word] + 1 } }
  counts
}

// Bars are drawn relative to the commonest word, so the chart fills the width
// whatever the passage turns out to be. Even a single mention gets one mark.
fn bar(count, peak, width = 28) { "#".repeat(max(1, round(count / peak * width))) }

fn main() {
  let words  = wordsOf(passage)
  let counts = tallyOf(words)

  // keys() hands back an ordinary List, so sort it alphabetically and then by
  // count. sortBy is stable, which means words on the same count keep the
  // alphabetical order rather than the order they happened to be first seen in.
  let ranked = counts.keys().sorted().sortBy(fn(key) { -counts[key] })
  let top    = ranked.take(10)
  let peak   = max(counts.values())

  print("Most common words")
  for word in top {
    print("  ${word.padEnd(9)} ${str(counts[word]).padStart(3)}  ${bar(counts[word], peak)}")
  }

  // Two figures worth having next to that chart: how much of a paragraph is
  // carried by a handful of words, and how long the tail of one-offs is.
  let shown = top.map(fn(key) { counts[key] }).sum()
  let share = round(shown / len(words) * 100)
  let once  = counts.values().count(fn(n) { n == 1 })

  print("")
  print("${len(words)} words, ${counts.len()} of them different.")
  print("The ten above are ${share}% of the passage; ${once} words appear exactly once.")
}
