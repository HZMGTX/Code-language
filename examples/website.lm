// A real website in one file.
//
//   lumen serve examples/website.lm
//   curl http://127.0.0.1:3000
//
// `serve` keeps running until you stop it with Ctrl-C.

import { serve, router, route, page, json, notFound, escape, url } from "std/web"
import { map, join, find } from "std/list"

struct Post {
  slug:  Str,
  title: Str,
  body:  Str,
}

let posts = [
  Post {
    slug:  "why-lumen",
    title: "Why Lumen",
    body:  "One language for scripts, servers, websites, and AI — with no exceptions, no async colouring, and no dependencies.",
  },
  Post {
    slug:  "no-exceptions",
    title: "Errors are values",
    body:  "Anything that can fail returns a Result. `?` unwraps it or hands the error back to your caller.",
  },
]

// `escape` for the text, `url` for the link. These slugs are the program's own
// and could go in bare, but an `href` built by interpolation is exactly where
// the habit has to already be — `escape` cannot make a link safe, because there
// is nothing in `javascript:alert(1)` to escape.
fn postLink(p) -> Str {
  "<li><a href='${url("/post/" + p.slug)}'>${escape(p.title)}</a></li>"
}

fn indexPage() {
  let items = posts |> map(postLink) |> join("")
  page(
    title: "Lumen",
    body: "<h1>Lumen</h1>
           <p>A site served by a language that is only a few hundred lines old.</p>
           <ul>${items}</ul>
           <p><a href='/health'>health check</a></p>",
  )
}

fn postPage(slug) {
  match posts |> find(fn(p) { p.slug == slug }) {
    Some(p) => page(
      title: p.title,
      body:  "<h1>${escape(p.title)}</h1><p>${escape(p.body)}</p><p><a href='/'>back</a></p>",
    ),
    None => notFound("<h1>404</h1><p>No post called <code>${escape(slug)}</code>.</p>"),
  }
}

// `router` rather than a chain of `if req.path == ...`. Three things come with
// it that the chain got wrong or left out:
//
//   - `:slug` names the captured piece, where the chain had `slice(req.path, 6)`
//     — a 6 that had to be recounted every time the prefix was edited.
//   - A POST to a page that only answers GET gets 405 with an `allow` header,
//     not 404. "Wrong URL" and "wrong verb" are different mistakes, and a client
//     cannot tell them apart if both come back the same.
//   - `/post/why-lumen/` and `/post/why-lumen` are one route. Links and browsers
//     add and remove that slash freely.
//
// Order matters: the specific route goes above the one with the hole in it, or
// `/post/:slug` would answer for `/post/new` too.
let handle = router(
  [
    route("GET", "/",            fn(req) { indexPage() }),
    route("GET", "/health",      fn(req) { json({ ok: true, posts: len(posts) }) }),
    route("GET", "/post/:slug",  fn(req) { postPage(req.params.slug) }),
  ],
  notFound: fn(req) {
    notFound("<h1>404</h1><p>Nothing at <code>${escape(req.path)}</code>.</p>")
  },
)

serve(handler: handle, port: 3000)
